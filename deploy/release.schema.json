{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xmrswap-release.schema.json",
  "title": "xmrswap release manifest",
  "description": "release.json of a recorded build (releases/<version>/): one commit and, for each artefact built from it, a content hash. Beside it sit web.SHA256SUMS and console.SHA256SUMS; each tree hash is the SHA-256 of that file. Written by `pnpm --filter @xmrswap/deploy run release`, checked by `run verify`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "status",
    "commit",
    "commit_time",
    "program_id",
    "contract",
    "chain_id",
    "program_executable_hash",
    "program_hash_source",
    "web_tree_hash",
    "console_tree_hash",
    "web_cid",
    "console_cid",
    "cid_params",
    "onchain",
    "tools",
    "build",
    "program_builds",
    "web",
    "console"
  ],
  "properties": {
    "format": {
      "const": "xmrswap-release/1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"
    },
    "status": {
      "enum": [
        "development-snapshot",
        "release"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "commit_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "onchain": {
      "type": "object",
      "description": "Whether the program of this manifest is deployed. While false there is nothing on-chain to compare with.",
      "additionalProperties": false,
      "required": [
        "deployed"
      ],
      "properties": {
        "deployed": {
          "type": "boolean"
        },
        "cluster": {
          "type": "string"
        }
      }
    },
    "tools": {
      "type": "object",
      "description": "Versions of the tools on the machine that made the manifest, as each tool reports itself.",
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      },
      "propertyNames": {
        "pattern": "^[a-z_]+$"
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "wasm_rustflags",
        "lockfile"
      ],
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9_]+$"
        },
        "wasm_rustflags": {
          "type": "string"
        },
        "lockfile": {
          "description": "frozen: dependencies were installed exactly from the commit's pnpm-lock.yaml. updated: the lockfile was behind the commit's package.json files and pnpm resolved the missing entries, so those dependencies are not pinned by the commit. prebuilt: the artefacts were supplied, not built.",
          "enum": [
            "frozen",
            "updated",
            "prebuilt"
          ]
        }
      }
    },
    "program_id": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "contract": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "chain_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "program_executable_hash": {
      "$ref": "#/definitions/sha256",
      "description": "The executable hash to expect on-chain: the Docker build's when one is recorded, otherwise the local build's."
    },
    "program_hash_source": {
      "description": "Which build program_executable_hash comes from. A release must say docker; local is this machine's build and is not a reproducibility proof.",
      "enum": [
        "docker",
        "local"
      ]
    },
    "web_tree_hash": {
      "$ref": "#/definitions/sha256"
    },
    "console_tree_hash": {
      "$ref": "#/definitions/sha256"
    },
    "web_cid": {
      "$ref": "#/definitions/cid"
    },
    "console_cid": {
      "$ref": "#/definitions/cid"
    },
    "cid_params": {
      "type": "string"
    },
    "program_builds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/program"
      }
    },
    "web": {
      "$ref": "#/definitions/tree"
    },
    "console": {
      "$ref": "#/definitions/tree"
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "double_build": {
      "description": "identical: built twice from clean in two different directories with the same result. not-run: built once, or supplied prebuilt.",
      "enum": [
        "identical",
        "not-run"
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "size",
        "sha256",
        "executable_hash",
        "command",
        "double_build"
      ],
      "properties": {
        "method": {
          "description": "How the binary was built. Hashes from different methods are not expected to be equal and must never be compared with each other.",
          "enum": [
            "local-sbf",
            "solana-verify-docker"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "executable_hash": {
          "$ref": "#/definitions/sha256"
        },
        "command": {
          "type": "string"
        },
        "double_build": {
          "$ref": "#/definitions/double_build"
        },
        "image": {
          "type": "string",
          "description": "Docker builds: the image the build ran in, with its digest."
        },
        "tool": {
          "type": "string",
          "description": "Docker builds: the solana-verify version that ran the build."
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "bytes",
        "command",
        "double_build"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "command": {
          "type": "string"
        },
        "double_build": {
          "$ref": "#/definitions/double_build"
        }
      }
    },
    "cid": {
      "type": "string",
      "pattern": "^bafy[a-z2-7]{55}$"
    }
  }
}
