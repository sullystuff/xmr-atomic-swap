{
  "name": "@xmrswap/svm-rpc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test-only loopback Solana JSON-RPC facade over an in-memory LiteSVM (docs/SPEC.md 9.2): the Rust binary and a helper that starts it",
  "main": "./src-ts/index.mjs",
  "types": "./src-ts/index.d.mts",
  "exports": {
    ".": {
      "types": "./src-ts/index.d.mts",
      "default": "./src-ts/index.mjs"
    },
    "./client": {
      "types": "./src-ts/client.d.mts",
      "default": "./src-ts/client.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cargo build --locked",
    "test": "cargo build --locked && tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.1.1",
    "@types/node": "22.20.5",
    "@solana/web3.js": "1.98.4",
    "@solana/spl-token": "0.4.15"
  }
}
