{
  "name": "@xmrswap/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chain clients, Monero verify/watch, taker and maker flows, message transports, signing, registry and router (SPEC 10.2, WP5)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/ensure-core.mjs && tsc -p tsconfig.json --noEmit && vitest run",
    "test:integration": "node scripts/ensure-core.mjs && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@xmrswap/core-wasm": "workspace:*",
    "@xmrswap/protocol": "workspace:*",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@solana/web3.js": "1.98.4",
    "@coral-xyz/anchor": "0.32.1",
    "@solana/spl-token": "0.4.15",
    "viem": "2.58.4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.1.1",
    "@types/node": "22.20.5"
  }
}
