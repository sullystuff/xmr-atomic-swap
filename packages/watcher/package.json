{
  "name": "@xmrswap/watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watcher service: follows swaps that name it, verifies the Monero lock view-only, and freezes when the lock is bad or missing (SPEC 11.6, Amendment 1, A5)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "xmrswap-watcher": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/ensure-deps.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node scripts/ensure-deps.mjs && tsc -p tsconfig.test.json && vitest run",
    "test:integration": "node scripts/ensure-deps.mjs && flock /tmp/xmrswap-integration.lock vitest run --config vitest.integration.config.ts",
    "start": "tsx src/cli.ts start"
  },
  "dependencies": {
    "@xmrswap/core-wasm": "workspace:*",
    "@xmrswap/protocol": "workspace:*",
    "@xmrswap/sdk": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "viem": "2.58.4",
    "express": "4.22.3",
    "better-sqlite3": "13.2.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@xmrswap/svm-rpc": "workspace:*",
    "@noble/curves": "2.4.0",
    "@solana/spl-token": "0.4.15",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.1.1",
    "@types/node": "22.20.5",
    "@types/express": "4.17.25",
    "@types/better-sqlite3": "9.6.0"
  }
}
